<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F5F9"
    android:fillViewport="true">


    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#B5A8E8"
            app:titleTextColor="@color/black"
            app:title="QUẢN LÝ THU CHI"
            android:textStyle="bold"

            xmlns:app="http://schemas.android.com/apk/res-auto"/>


        <!-- DATE AND TIME -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <!-- DATE -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ngày giao dịch"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#263B63"
                    android:gravity="center"
                    android:layout_marginBottom="4dp"/>

                <Button
                    android:id="@+id/btnNgay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#B5A8E8"
                    android:textColor="@color/black"
                    android:text="Chọn ngày"/>

            </LinearLayout>

            <!-- TIME -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Giờ giao dịch"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#263B63"
                    android:gravity="center"
                    android:layout_marginBottom="4dp"/>

                <Button
                    android:id="@+id/btnGio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#B5A8E8"
                    android:textColor="@color/black"
                    android:text="Chọn giờ"/>
            </LinearLayout>

        </LinearLayout>

        <!-- AMOUNT -->
        <EditText
            android:id="@+id/edtSoTien"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Số tiền (VNĐ)"
            android:inputType="number"
            android:singleLine="true"
            android:padding="10dp"/>

        <!-- CATEGORY -->
        <EditText
            android:id="@+id/edtPhanLoai"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Phân loại (Ăn uống, Lương...)"
            android:inputType="textCapSentences"
            android:singleLine="true"
            android:padding="10dp"/>

        <!-- INCOME / EXPENSE -->
        <RadioGroup
            android:id="@+id/rgLoaiGiaoDich"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbThu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Thu nhập"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/rbChi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Chi tiêu"/>
        </RadioGroup>



        <!-- SAVE -->
        <Button
            android:id="@+id/btnLuu"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="LƯU GIAO DỊCH"
            android:backgroundTint="#B5A8E8"
            android:textColor="@color/black"/>

        <!-- TOTALS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvTongThu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tổng thu: 0 đ"
                android:textColor="#16834A"
                android:textStyle="bold"
                android:textSize="14sp"
                android:padding="6dp"/>

            <TextView
                android:id="@+id/tvTongChi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tổng chi: 0 đ"
                android:textColor="#D04444"
                android:textStyle="bold"
                android:textSize="14sp"
                android:padding="6dp"/>
        </LinearLayout>


        <!-- RECYCLERVIEW -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGiaoDich"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"/>

    </LinearLayout>
</ScrollView>
